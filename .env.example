OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60
# LLM backend: ollama (local) or anthropic (Claude Haiku 5.5 through the Claude API)
LLM_BACKEND=ollama
# Required when LLM_BACKEND=anthropic; never commit a real key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Cap on tokens in each answer (answers are 1-3 sentences)
MAX_OUTPUT_TOKENS=300
# JSON list of browser origins allowed to call the API (the web app in web/)
CORS_ORIGINS=["http://localhost:3000"]
# Question log: set both to store it in Upstash Redis (kept 90 days); empty keeps it in memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# URL or path of the site's knowledge.json; empty uses the built-in knowledge base
KNOWLEDGE_SOURCE=
# Questions per visitor per hour, and across all visitors per UTC day
RATE_LIMIT_PER_HOUR=10
DAILY_QUESTION_CAP=300
